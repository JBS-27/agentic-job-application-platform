# ---------------------------------------------------------------------------
# Backend environment variables — copy this file to `.env` and fill in
# real values locally. NEVER commit the actual .env file.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
DEBUG=True

# --- API ---
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# --- Database (MongoDB) ---
# Use a local MongoDB or a free-tier MongoDB Atlas cluster.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=job_application_platform

# --- LLM provider (provider-agnostic) ---
# LLM_BASE_URL must be an OpenAI-compatible /chat/completions endpoint.
# Examples:
#   OpenAI:      https://api.openai.com/v1        (model: gpt-4o-mini, etc.)
#   Groq:        https://api.groq.com/openai/v1   (model: llama-3.1-8b-instant, etc.)
#   Together AI: https://api.together.xyz/v1
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL_NAME=your_model_name_here
LLM_REQUEST_TIMEOUT_SECONDS=60

# --- File storage / upload limits ---
RESUME_UPLOAD_DIR=uploads/resumes
MAX_UPLOAD_SIZE_MB=5
MIN_EXTRACTED_TEXT_CHARS=30
