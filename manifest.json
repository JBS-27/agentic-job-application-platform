{
  "manifest_version": 3,
  "name": "LinkedIn Easy Apply",
  "version": "1.3.7",
  "description": "Start/stop helper that searches Easy Apply jobs and fills applications in your logged-in LinkedIn tab.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "easy-apply-helper@local",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "LinkedIn Easy Apply",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*", "https://linkedin.com/*"],
      "js": ["src/brain.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
